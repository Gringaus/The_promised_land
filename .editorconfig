root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.cs]
indent_size = 4
# Keep the simulation assembly compatible with what Unity 6 accepts (C# 9):
# no file-scoped namespaces, no global usings, no records/init in the sim core.
csharp_style_namespace_declarations = block_scoped:warning

[*.{json,asmdef,csproj,props}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
