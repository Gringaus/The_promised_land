# ----------------------------------------------------------------------------
# Unity-generated folders and files
# ----------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the asset itself is ignored
!/[Aa]ssets/**/*.meta

# Unity3D-generated crash reports and build artifacts
/[Aa]ssets/[Aa]ssetStoreTools*
/[Aa]ssets/[Pp]lugins/[Ee]ditor/JetBrains*
ExportedObj/
.consulo/
crashlytics-build.properties
sysinfo.txt
*.apk
*.aab
*.unitypackage
*.app

# Unity-generated IDE/project files (regenerated by the Editor at the repo root)
/*.csproj
/*.sln
/*.unityproj
/*.user
/*.userprefs
/.vs/
/.idea/
/.vscode/

# ----------------------------------------------------------------------------
# .NET build output (headless SimHarness and Unity's Library compile)
# ----------------------------------------------------------------------------
[Bb]in/
[Oo]bj/

# Keep the hand-authored headless harness project files (NOT Unity-generated).
!SimHarness/**/*.csproj
!SimHarness/**/*.sln
!SimHarness/**/*.cs

# ----------------------------------------------------------------------------
# OS / misc
# ----------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
