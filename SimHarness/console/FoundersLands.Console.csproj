<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless preview tool: generates a map from a seed and prints stats + an ASCII
       minimap. Lets us "see" world generation (GDD §7) without the Unity Editor. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Build targets .NET 8, but roll forward across a major version so the app also runs on a
         machine that only has a newer runtime installed (e.g. .NET 10) without a separate .NET 8. -->
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FoundersLands.SimViewer</AssemblyName>
    <RootNamespace>FoundersLands.SimViewer</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../src/FoundersLands.Simulation.csproj" />
  </ItemGroup>

</Project>
